layout {
    background-color "transparent"

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    focus-ring {
        off
    }

    border {
        on
        width 3

        active-color "#98c379"
        inactive-color "#3e4451"
    }

    shadow {
        on
        softness 20
        spread 7
        offset x=0 y=5
        draw-behind-window true
        color "#00000070"
        inactive-color "#00000054"
    }

    gaps 5

    struts {
        left 5
        right 5
        top 5
    }
}

animations {
    slowdown 1.0
}
