window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
}

// layer-rule {
//     match namespace="^awww-daemon$"
//     place-within-backdrop true
// }

window-rule {
    draw-border-with-background false
    match app-id="kitty"
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    draw-border-with-background false
    match app-id="sioyek"
    match app-id="emacs"
    opacity 0.9
    background-effect {
        blur true
    }
}

window-rule {
    draw-border-with-background false
    match app-id="Tk"
    open-floating true
}

