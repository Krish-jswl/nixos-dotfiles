layout {
    background-color "transparent"

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    focus-ring {
        off
    }

    border {
        on
        width 3

        active-color "#A9B665"
        inactive-color "#504945"
    }

    gaps 6

    struts {
        left 5
        right 5
        top 5
    }
}

animations {
    slowdown 1.0
}
