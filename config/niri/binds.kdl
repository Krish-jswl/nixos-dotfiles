// Keybindings
binds {

    Mod+Tab { focus-workspace-previous; }
    Mod+Space { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // launch apps
    Mod+Return { spawn "kitty"; }
    Mod+R { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B { spawn "librewolf"; }
    Mod+Escape { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+E { spawn "nautilus" "--new-window"; }
    Mod+W { spawn-sh "noctalia msg panel-toggle wallpaper"; }

    // media keys
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "noctalia msg volume-up 5"
    }

    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "noctalia msg volume-down 5"
    }

    XF86AudioMute allow-when-locked=true {
        spawn-sh "noctalia msg volume-mute"
    }

    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "noctalia msg mic-mute"
    }

    // brightness keys
    XF86MonBrightnessDown allow-when-locked=true {
        spawn-sh "noctalia msg brightness-down 2%"
    }

    XF86MonBrightnessUp allow-when-locked=true {
        spawn-sh "noctalia msg brightness-up 2%"
    }

    // window management
    Mod+Q { close-window; }
    Mod+Shift+Space { toggle-window-floating; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // move windows
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // workspace navigation
    Mod+P { focus-workspace-up; }
    Mod+N { focus-workspace-down; }

    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+H { move-column-to-workspace-down; }
    Mod+Shift+L { move-column-to-workspace-up; }

    // workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }

    // move columns to workspaces
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // resize window
    Mod+BracketLeft {
        spawn "niri" "msg" "action" "set-window-width" "-20";
    }

    Mod+BracketRight {
        spawn "niri" "msg" "action" "set-window-width" "+20";
    }

    Mod+Shift+BracketLeft {
        spawn "niri" "msg" "action" "set-window-height" "-20";
    }

    Mod+Shift+BracketRight {
        spawn "niri" "msg" "action" "set-window-height" "+20";
    }

    // layout
    Mod+D { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    // screenshots
    Print       { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    // quit
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // Mod+Shift+P { power-off-monitors; }
}
